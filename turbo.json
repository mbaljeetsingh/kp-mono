{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["SUPABASE_URL", "SUPABASE_KEY", "NETLIFY"],
  // shared-theme/ is gone: the tokens now live in packages/tokens, which is
  // inside a workspace glob, so turbo's per-package hash sees them on its own.
  // .nvmrc still needs naming — nothing else watches a Node version bump.
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      // .env is gitignored, so it is absent from the default input hash, and
      // Vite (not the shell) loads it — turbo's env hash never sees those
      // values either. Listing it explicitly keeps a local `.env` edit from
      // replaying a stale bundle with the previous Supabase URL in it.
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": ["dist/**", ".netlify/**"]
    }
  }
}
