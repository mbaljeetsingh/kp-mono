# Player and admin apps (apps/*/.env) — the publishable key is safe in a browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<PUBLISHABLE_KEY from `npx supabase status`>

# Seeder only. Bypasses RLS — never commit this and never ship it to a client.
SUPABASE_SERVICE_KEY=<SECRET_KEY from `npx supabase status`>
