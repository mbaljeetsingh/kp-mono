# Copy to .env. Vite inlines both at build time, so a build without them throws
# on load rather than failing quietly — see src/lib/supabase.ts, which names
# this file in its error.
#
# Local development points at the Supabase the repo runs itself:
VITE_SUPABASE_URL=http://localhost:54521
VITE_SUPABASE_KEY=<the publishable key from `npx supabase status`>

# Netlify holds the production pair in its own environment settings, under
# these exact names. They were SUPABASE_URL/SUPABASE_KEY for the Nuxt app, and
# a build that still finds only those throws on first load.
#
# Plaintext rather than secret on purpose: the publishable key is public by
# design and ships inside the bundle either way. The service key is the one
# that must never be here.
