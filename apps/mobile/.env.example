# Copy to .env. Both are read at bundle time, so a build without them throws on
# launch rather than failing quietly — see src/lib/supabase.ts.
#
# Local development points at the Supabase the repo runs itself:
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54521
EXPO_PUBLIC_SUPABASE_KEY=<the publishable key from `npx supabase status`>

# A cloud build has no .env — it is gitignored and never uploaded — so preview
# and production builds read these from EAS instead:
#
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value https://<ref>.supabase.co \
#     --environment preview --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_KEY --value <publishable key> \
#     --environment preview --environment production --visibility plaintext
#
# Plaintext rather than secret on purpose: the publishable key is public by
# design and already ships inside the web bundle. The service key is the one
# that must never be here.
