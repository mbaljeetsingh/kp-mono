@@ -0,0 +1,83 @@
+package expo.modules.audio.service
+
+import androidx.media3.common.C
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+
+/**
+ * kp-mono: what the media session sees of the player.
+ *
+ * The session reads its clock and its commands from this, so the lock screen
+ * shows a slice of the file as the whole track — its own length, its own
+ * position, a drag that stays inside it — while the real player and everything
+ * JavaScript hears stay on the file's clock. Next and previous are offered even
+ * though the player holds one item: the queue lives in JavaScript, so the
+ * buttons only say they were pressed.
+ */
+@UnstableApi
+internal class LockScreenPlayer(
+  player: Player,
+  private val isLive: Boolean,
+  segmentMs: LongRange?,
+  private val onCommand: (String) -> Unit
+) : ForwardingPlayer(player) {
+  private val startMs = segmentMs?.first ?: 0L
+  private val lengthMs = segmentMs?.let { it.last - it.first }
+
+  override fun isCommandAvailable(command: Int): Boolean =
+    when (command) {
+      in TRACK_COMMANDS -> true
+      Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM -> !isLive && super.isCommandAvailable(command)
+      else -> super.isCommandAvailable(command)
+    }
+
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon().addAll(*TRACK_COMMANDS)
+    if (isLive) commands.remove(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+    return commands.build()
+  }
+
+  override fun hasNextMediaItem() = true
+  override fun hasPreviousMediaItem() = true
+  override fun seekToNext() = onCommand("next")
+  override fun seekToNextMediaItem() = onCommand("next")
+  override fun seekToPrevious() = onCommand("previous")
+  override fun seekToPreviousMediaItem() = onCommand("previous")
+
+  private fun toSegment(fileMs: Long): Long {
+    val length = lengthMs ?: return fileMs
+    return (fileMs - startMs).coerceIn(0L, length)
+  }
+
+  private fun toFile(segmentPositionMs: Long): Long {
+    val length = lengthMs ?: return segmentPositionMs
+    return startMs + segmentPositionMs.coerceIn(0L, length)
+  }
+
+  override fun getDuration(): Long = lengthMs ?: super.getDuration()
+  override fun getContentDuration(): Long = lengthMs ?: super.getContentDuration()
+  override fun getCurrentPosition(): Long = toSegment(super.getCurrentPosition())
+  override fun getContentPosition(): Long = toSegment(super.getContentPosition())
+  override fun getBufferedPosition(): Long = toSegment(super.getBufferedPosition())
+  override fun getContentBufferedPosition(): Long = toSegment(super.getContentBufferedPosition())
+
+  override fun getBufferedPercentage(): Int {
+    val length = lengthMs ?: return super.getBufferedPercentage()
+    return if (length == 0L) 0 else (bufferedPosition * 100 / length).toInt()
+  }
+
+  override fun seekTo(positionMs: Long) = super.seekTo(toFile(positionMs))
+
+  override fun seekTo(mediaItemIndex: Int, positionMs: Long) =
+    super.seekTo(mediaItemIndex, if (positionMs == C.TIME_UNSET) positionMs else toFile(positionMs))
+
+  private companion object {
+    val TRACK_COMMANDS = intArrayOf(
+      Player.COMMAND_SEEK_TO_PREVIOUS,
+      Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM,
+      Player.COMMAND_SEEK_TO_NEXT,
+      Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM
+    )
+  }
+}
